# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/talkops?retryWrites=true&w=majority

# Firebase web app configuration (safe for the browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin service account (server-only)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Keep escaped newlines (\n) when setting this value in Vercel.
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Razorpay checkout
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Campaign affiliate destinations
NEXT_PUBLIC_INTERAKT_REFERRAL_URL=https://www.interakt.shop/
NEXT_PUBLIC_AISENSY_REFERRAL_URL=https://aisensy.com/

# Provisioning defaults exposed to the onboarding selector.
# Replace this with provider-backed server inventory before assigning real numbers.
NEXT_PUBLIC_DEFAULT_TWILIO_PHONE_NUMBERS=+918047120001,+918047120002,+918047120003

# Public application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
